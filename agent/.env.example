# คัดลอกเป็น agent/.env แล้วใส่ค่าจริง (ห้าม commit .env)

# --- MQTT (ต้องตรงกับทุกเครื่องในทีม) ---
TESA_TEAM=kucoffee26
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_TLS=0

# --- ตลาด (ตอนซ้อม = services/market/mock_market.py) ---
MARKET_URL=http://127.0.0.1:8000
MARKET_API_TOKEN=
MARKET_TIMEOUT=10

# --- LLM (ตอนซ้อม = Ollama ในเครื่อง / วันแข่ง = LLM ของผู้จัด) ---
LLM_BASE_URL=http://localhost:11434/v1/
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:2b
LLM_TIMEOUT=20
# none = ปิด thinking (เร็ว) / ว่าง = ไม่ส่ง param นี้ ถ้า LLM ผู้จัดไม่รองรับ
LLM_REASONING=none
# 0 = ปิด response_format JSON ถ้า LLM ผู้จัดไม่รองรับ
LLM_JSON_MODE=1
# LLM ปรับราคาได้ไม่เกิน ±2% จากราคาที่กฎคำนวณ (0 = ห้ามแก้ราคา)
LLM_PRICE_BAND=0.02
# ถาม LLM เฉพาะเมื่อตัวเลือกสูสีกับอันดับ 1 ไม่เกิน 10%
LLM_CHOICE_GAP=0.10
